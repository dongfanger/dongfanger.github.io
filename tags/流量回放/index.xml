    <item>
      <title>基于 HAR 包的流量录制回放</title>
      <link>https://dongfanger.github.io/posts/%E6%B5%8B%E8%AF%95/%E5%9F%BA%E4%BA%8Ehar%E5%8C%85%E7%9A%84%E6%B5%81%E9%87%8F%E5%BD%95%E5%88%B6%E5%9B%9E%E6%94%BE/</link>
      <pubDate>Sat, 03 Jan 2026 00:00:00 +0000</pubDate>
