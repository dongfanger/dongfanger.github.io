    <item>
      <title>测试的道与术</title>
      <link>https://dongfanger.github.io/posts/%E8%AF%BB%E4%B9%A6%E4%B8%8E%E6%80%9D%E8%80%83/%E4%B8%AA%E4%BA%BA%E6%80%9D%E8%80%83/000007-%E6%B5%8B%E8%AF%95%E7%9A%84%E9%81%93%E4%B8%8E%E6%9C%AF/</link>
