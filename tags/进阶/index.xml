    <item>
      <title>Java高级编程精华笔记</title>
      <link>https://dongfanger.github.io/posts/java%E7%94%9F%E6%80%81/java/000002-%E8%BF%9B%E9%98%B6java%E9%AB%98%E7%BA%A7%E7%BC%96%E7%A8%8B%E7%B2%BE%E5%8D%8E%E7%AC%94%E8%AE%B0/</link>
